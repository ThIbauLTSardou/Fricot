# Clés API Edamam — Recipe Search API.
# Crée un compte gratuit sur https://developer.edamam.com puis, dans le
# Dashboard, crée une application de type "Recipe Search API".
# Copie ce fichier en ".env" et colle tes valeurs ci-dessous.
#
# ⚠️ Ces variables EXPO_PUBLIC_* sont incluses dans le build client
# (normal pour une app mobile). Ne mets jamais ici une clé serveur sensible.

EXPO_PUBLIC_EDAMAM_APP_ID=ton_app_id
EXPO_PUBLIC_EDAMAM_APP_KEY=ta_app_key

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://ecksndbmkouamnyyngog.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=ta_cle_anon
